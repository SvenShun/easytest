# EasyTest V1 environment template. Copy to .env (git-ignored) and change every secret
# before any non-local deployment. For local development the built-in defaults work.

# --- shared security (all services must agree) ---
EASYTEST_JWT_SECRET=easytest-dev-jwt-secret-change-me-0123456789abcdef
EASYTEST_SERVICE_TOKEN=easytest-dev-service-token
EASYTEST_AGENT_TOKEN=easytest-dev-agent-token
EASYTEST_ENCRYPTION_KEY=easytest-dev-encryption-key-change-me

# --- core (easytest-server :8080) ---
# SPRING_PROFILES_ACTIVE=mysql
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/easytest_core?useSSL=false&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=easytest
EASYTEST_PUBLIC_BASE_URL=http://127.0.0.1:8080
EASYTEST_UI_EXECUTION_BASE_URL=http://127.0.0.1:8081
EASYTEST_ARTIFACT_DIR=./data/core-artifacts
EASYTEST_ARTIFACT_STORE=local

# --- ui-execution (:8081) ---
# EASYTEST_CORE_URL=http://127.0.0.1:8080
# EASYTEST_UIEXEC_PUBLIC_URL=http://127.0.0.1:8081
# EASYTEST_QUEUE_STORE=redis
# EASYTEST_EVENT_BUS=kafka
# EASYTEST_KAFKA_BOOTSTRAP=127.0.0.1:9092
# SPRING_DATA_REDIS_HOST=127.0.0.1
# EASYTEST_ARTIFACT_STORE=minio
EASYTEST_MINIO_ENDPOINT=http://127.0.0.1:9000
EASYTEST_MINIO_ACCESS_KEY=easytest
EASYTEST_MINIO_SECRET_KEY=easytest123
EASYTEST_MINIO_BUCKET=easytest

# --- device-agent (:8090) ---
EASYTEST_AGENT_NAME=device-agent-1
EASYTEST_AGENT_BASE_URL=http://127.0.0.1:8090
EASYTEST_UIEXEC_URL=http://127.0.0.1:8081
EASYTEST_RUNTIME_URL=http://127.0.0.1:8095
EASYTEST_AGENT_MODE=simulated

# --- MeterSphere integration (optional) ---
# EASYTEST_METERSPHERE_WRITEBACK=true
# EASYTEST_METERSHPHERE_BASE_URL=http://127.0.0.1:8082
# EASYTEST_METERSHPHERE_PROJECT_ID=100001100001
# EASYTEST_METERSHPHERE_TOKEN=
# EASYTEST_METERSHPHERE_CSRF_TOKEN=
# EASYTEST_METERSHPHERE_USERNAME=admin
# EASYTEST_METERSHPHERE_PASSWORD=metersphere
EASYTEST_AGENT_DATA_DIR=./data/agent

# --- docker compose only ---
MYSQL_ROOT_PASSWORD=easytest
MINIO_ROOT_USER=easytest
MINIO_ROOT_PASSWORD=easytest123

# API execution shared queue (memory|redis) and instance identity
# EASYTEST_APIEXEC_QUEUE=redis
# EASYTEST_APIEXEC_INSTANCE_ID=apiexec-1
# EASYTEST_APIEXEC_WORKERS=4
