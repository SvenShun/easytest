# TestHub V1 environment template. Copy to .env (git-ignored) and change every secret
# before any non-local deployment. For local development the built-in defaults work.

# --- shared security (all services must agree) ---
TESTHUB_JWT_SECRET=testhub-dev-jwt-secret-change-me-0123456789abcdef
TESTHUB_SERVICE_TOKEN=testhub-dev-service-token
TESTHUB_AGENT_TOKEN=testhub-dev-agent-token
TESTHUB_ENCRYPTION_KEY=testhub-dev-encryption-key-change-me

# --- core (testhub-server :8080) ---
# SPRING_PROFILES_ACTIVE=mysql
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/testhub_core?useSSL=false&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=testhub
TESTHUB_PUBLIC_BASE_URL=http://127.0.0.1:8080
TESTHUB_UI_EXECUTION_BASE_URL=http://127.0.0.1:8081
TESTHUB_ARTIFACT_DIR=./data/core-artifacts
TESTHUB_ARTIFACT_STORE=local

# --- ui-execution (:8081) ---
# TESTHUB_CORE_URL=http://127.0.0.1:8080
# TESTHUB_UIEXEC_PUBLIC_URL=http://127.0.0.1:8081
# TESTHUB_QUEUE_STORE=redis
# SPRING_DATA_REDIS_HOST=127.0.0.1
# TESTHUB_ARTIFACT_STORE=minio
TESTHUB_TESTHUB_MINIO_ENDPOINT=http://127.0.0.1:9000
TESTHUB_TESTHUB_MINIO_ACCESS_KEY=testhub
TESTHUB_TESTHUB_MINIO_SECRET_KEY=testhub123
TESTHUB_MINIO_BUCKET=testhub

# --- device-agent (:8090) ---
TESTHUB_AGENT_NAME=device-agent-1
TESTHUB_AGENT_BASE_URL=http://127.0.0.1:8090
TESTHUB_UIEXEC_URL=http://127.0.0.1:8081
TESTHUB_RUNTIME_URL=http://127.0.0.1:8095
TESTHUB_AGENT_MODE=simulated
TESTHUB_AGENT_DATA_DIR=./data/agent

# --- docker compose only ---
MYSQL_ROOT_PASSWORD=testhub
MINIO_ROOT_USER=testhub
MINIO_ROOT_PASSWORD=testhub123
