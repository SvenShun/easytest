FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY deploy/maven-settings.xml /root/.m2/settings.xml
COPY pom.xml .
COPY common/pom.xml common/pom.xml
COPY testhub-server/pom.xml testhub-server/pom.xml
COPY ui-execution/pom.xml ui-execution/pom.xml
COPY device-agent/pom.xml device-agent/pom.xml
COPY api-execution/pom.xml api-execution/pom.xml
RUN mvn -B -q -pl device-agent -am -DskipTests dependency:go-offline
COPY device-agent device-agent
RUN mvn -B -q -pl device-agent -am -DskipTests package

FROM eclipse-temurin:17-jre
RUN apt-get update && apt-get install -y --no-install-recommends git fontconfig fonts-dejavu-core zip unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/device-agent/target/device-agent-1.0.0.jar app.jar
EXPOSE 8090
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75","-Djava.awt.headless=true","-jar","/app/app.jar"]
