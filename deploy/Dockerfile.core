FROM public.ecr.aws/docker/library/maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY deploy/maven-settings.xml /root/.m2/settings.xml
COPY pom.xml .
COPY engineering-sdk/pom.xml engineering-sdk/pom.xml
COPY common/pom.xml common/pom.xml
COPY contract-api/pom.xml contract-api/pom.xml
COPY easytest-server/pom.xml easytest-server/pom.xml
COPY ui-execution/pom.xml ui-execution/pom.xml
COPY device-agent/pom.xml device-agent/pom.xml
COPY api-execution/pom.xml api-execution/pom.xml
RUN mvn -B -q -pl easytest-server -am -DskipTests dependency:go-offline
COPY common common
COPY easytest-server easytest-server
RUN mvn -B -q -pl easytest-server -am -DskipTests package

FROM public.ecr.aws/docker/library/eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/easytest-server/target/easytest-server-1.0.0.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75","-jar","/app/app.jar"]
