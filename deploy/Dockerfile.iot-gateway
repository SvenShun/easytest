FROM public.ecr.aws/docker/library/maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY deploy/maven-settings.xml /root/.m2/settings.xml
COPY examples/iot-local-system/pom.xml pom.xml
COPY examples/iot-local-system/iot-api/pom.xml iot-api/pom.xml
COPY examples/iot-local-system/iot-service/pom.xml iot-service/pom.xml
COPY examples/iot-local-system/iot-gateway/pom.xml iot-gateway/pom.xml
RUN mvn -B -q -pl iot-gateway -am -DskipTests dependency:go-offline
COPY examples/iot-local-system/iot-api iot-api
COPY examples/iot-local-system/iot-gateway iot-gateway
RUN mvn -B -q -pl iot-gateway -am -DskipTests package

FROM public.ecr.aws/docker/library/eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/iot-gateway/target/iot-gateway-1.0.0.jar app.jar
EXPOSE 18080
ENTRYPOINT ["java","--add-opens=java.base/java.lang=ALL-UNNAMED","--add-opens=java.base/java.math=ALL-UNNAMED","--add-opens=java.base/java.util=ALL-UNNAMED","--add-opens=java.base/java.lang.reflect=ALL-UNNAMED","-XX:MaxRAMPercentage=75","-jar","/app/app.jar"]
