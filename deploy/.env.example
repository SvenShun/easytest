# Docker Compose overrides (copy to deploy/.env)
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MINIO_ROOT_USER=testhub
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Use strong random values on a real host.
TESTHUB_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
TESTHUB_SERVICE_TOKEN=change-me-service-token
TESTHUB_AGENT_TOKEN=change-me-agent-token
TESTHUB_ENCRYPTION_KEY=change-me-encryption-key

# Address users' browsers use to reach the services.
TESTHUB_PUBLIC_BASE_URL=http://127.0.0.1:8080
TESTHUB_UIEXEC_PUBLIC_URL=http://127.0.0.1:8081
TESTHUB_APIEXEC_PUBLIC_URL=http://127.0.0.1:8084

# Host ports
TESTHUB_WEB_PORT=5173
