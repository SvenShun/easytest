# Docker Compose overrides (copy to deploy/.env)
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MINIO_ROOT_USER=easytest
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Use strong random values on a real host.
EASYTEST_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
EASYTEST_SERVICE_TOKEN=change-me-service-token
EASYTEST_AGENT_TOKEN=change-me-agent-token
EASYTEST_ENCRYPTION_KEY=change-me-encryption-key

# Address users' browsers use to reach the services.
EASYTEST_PUBLIC_BASE_URL=http://127.0.0.1:8080
EASYTEST_UIEXEC_PUBLIC_URL=http://127.0.0.1:8081
EASYTEST_APIEXEC_PUBLIC_URL=http://127.0.0.1:8084

# Host ports
EASYTEST_WEB_PORT=5173

# Local IoT demo services
IOT_DB_PASSWORD=iot
IOT_GATEWAY_URL=http://iot-gateway:18080
IOT_MYSQL_URL=jdbc:mysql://mysql:3306/iot_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
IOT_KAFKA_BOOTSTRAP=kafka:9092
IOT_MQTT_HOST=iot-service
IOT_MQTT_PORT=1883
